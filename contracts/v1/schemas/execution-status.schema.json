{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgecode:contracts:v1:execution-status",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state": {
      "enum": [
        "accepted",
        "running",
        "finished",
        "indeterminate"
      ]
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        {
          "type": "null"
        }
      ]
    },
    "stdout_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stderr_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "discarded_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine_epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^epoch-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sandbox_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^sandbox-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "execution_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "engine_epoch",
        "sandbox_session_id",
        "execution_id"
      ]
    }
  },
  "required": [
    "execution_id",
    "state",
    "exit_code",
    "stdout_bytes",
    "stderr_bytes",
    "discarded_bytes",
    "owner"
  ]
}
