{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgecode:contracts:v1:bridge-output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "execution_id": { "type": "string", "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "owner": { "$ref": "urn:forgecode:contracts:v1:owner-identity" },
    "stream": { "enum": ["stdout", "stderr"] },
    "sequence": { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" },
    "raw_base64": { "type": "string", "maxLength": 10924, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
    "text": { "type": "string", "maxLength": 8193 },
    "encoding": { "const": "utf-8" },
    "final": { "type": "boolean" }
  },
  "required": ["execution_id", "owner", "stream", "sequence", "raw_base64", "text", "encoding", "final"]
}
