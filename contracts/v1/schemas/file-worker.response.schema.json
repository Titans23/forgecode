{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgecode:contracts:v1:file-worker.response",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "forge.file-worker.response.v1"},
    "request_id": {"type": ["string", "null"], "maxLength": 64},
    "policy_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["ok", "error"]},
    "result": {"type": "object"},
    "observations": {"type": "object", "maxProperties": 1000, "additionalProperties": {"$ref": "#/$defs/observation"}},
    "error": {"type": "object", "additionalProperties": false, "properties": {
      "code": {"type": "string", "minLength": 1, "maxLength": 64},
      "message": {"type": "string", "minLength": 1, "maxLength": 512},
      "exception_type": {"type": "string", "maxLength": 128}
    }, "required": ["code", "message"]}
  },
  "required": ["schema_version", "request_id", "policy_hash", "status"],
  "oneOf": [
    {"properties": {"status": {"const": "ok"}}, "required": ["result", "observations"], "not": {"required": ["error"]}},
    {"properties": {"status": {"const": "error"}}, "required": ["error"], "not": {"anyOf": [{"required": ["result"]}, {"required": ["observations"]}]}}
  ],
  "$defs": {
    "observation": {"type": "object", "additionalProperties": false, "properties": {
      "exists": {"type": "boolean"}, "is_file": {"type": "boolean"},
      "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
      "file_identity": {"type": ["string", "null"], "pattern": "^[0-9]+:[0-9]+$"},
      "size_bytes": {"type": "integer", "minimum": 0},
      "content_base64": {"type": "string", "maxLength": 699052, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}
    }, "required": ["exists", "is_file", "sha256", "file_identity"]}
  }
}
