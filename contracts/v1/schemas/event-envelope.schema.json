{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgecode:contracts:v1:event-envelope",
  "title": "已持久化 EventEnvelope v1",
  "description": "commit 后查询／推送事件结构。store_seq 由 Engine 分配；原始 producer 输入另有不含 store_seq 的 schema。origin 为外部传入值时不具备可信性。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "forge.events.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 128
    },
    "origin": {
      "enum": [
        "trusted_engine",
        "trusted_bridge",
        "grader_adapter",
        "imported",
        "client_observation"
      ]
    },
    "producer_id": {
      "type": "string",
      "pattern": "^producer-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "producer_seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "occurred_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "monotonic_ns": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        {
          "type": "null"
        }
      ]
    },
    "store_seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "workspace_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ws-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ses-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "turn_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^turn-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^run-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trial_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^trial-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^attempt-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "not": {
            "const": "00000000000000000000000000000000"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "span_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "not": {
            "const": "0000000000000000"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "parent_span_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "not": {
            "const": "0000000000000000"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "attributes": {
      "type": "object",
      "maxProperties": 128,
      "description": "F17 按 event_type 再验证 payload schema；本文种子不能替代第二层验证。"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^art-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "maxItems": 64
    },
    "redaction_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "origin",
    "producer_id",
    "producer_seq",
    "occurred_at_utc",
    "monotonic_ns",
    "store_seq",
    "workspace_id",
    "session_id",
    "turn_id",
    "run_id",
    "trial_id",
    "attempt_id",
    "execution_id",
    "trace_id",
    "span_id",
    "parent_span_id",
    "attributes",
    "artifact_refs",
    "redaction_version"
  ]
}
