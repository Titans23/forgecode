{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgecode:contracts:v1:session",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^ses-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^ws-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state": {
      "enum": [
        "idle",
        "queued",
        "running",
        "cancel_requested",
        "completed",
        "failed",
        "cancelled",
        "indeterminate"
      ]
    },
    "created_at_utc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "format": "date-time",
      "pattern": "Z$"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^snap-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "snapshot_id",
        "sha256"
      ]
    },
    "active_turn_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^turn-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "session_id",
    "workspace_id",
    "state",
    "created_at_utc",
    "configuration",
    "active_turn_id"
  ]
}
