{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgecode:contracts:v1:bridge-payloads",
  "$defs": {
    "probe.request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^ws-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "workspace_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?:[A-Za-z]:[/\\\\]|/)(?![/\\\\]).*$"
        }
      },
      "required": [
        "workspace_id",
        "workspace_path"
      ]
    },
    "probe.result": {
      "$ref": "urn:forgecode:contracts:v1:capability-report"
    },
    "prepare.request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "urn:forgecode:contracts:v1:sandbox-policy"
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engine_epoch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^epoch-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "sandbox_session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^sandbox-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "execution_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "engine_epoch",
            "sandbox_session_id",
            "execution_id"
          ]
        }
      },
      "required": [
        "policy",
        "policy_hash",
        "owner"
      ]
    },
    "prepare.result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sandbox_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^sandbox-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "policy_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engine_epoch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^epoch-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "sandbox_session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^sandbox-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "execution_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "engine_epoch",
            "sandbox_session_id",
            "execution_id"
          ]
        },
        "capabilities": {
          "$ref": "urn:forgecode:contracts:v1:capability-report"
        },
        "state": {
          "const": "ready"
        }
      },
      "required": [
        "sandbox_session_id",
        "policy_hash",
        "owner",
        "capabilities",
        "state"
      ]
    },
    "execute.request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sandbox_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^sandbox-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "command": {
          "$ref": "urn:forgecode:contracts:v1:command-spec"
        },
        "command_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "sandbox_session_id",
        "execution_id",
        "command",
        "command_hash"
      ]
    },
    "execute.result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "state": {
          "enum": [
            "accepted",
            "running",
            "finished",
            "indeterminate"
          ]
        },
        "reused_existing_execution": {
          "type": "boolean"
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "engine_epoch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^epoch-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "sandbox_session_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^sandbox-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "execution_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "engine_epoch",
            "sandbox_session_id",
            "execution_id"
          ]
        }
      },
      "required": [
        "execution_id",
        "state",
        "reused_existing_execution",
        "owner"
      ]
    },
    "status.request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "execution_id"
      ]
    },
    "status.result": {
      "$ref": "urn:forgecode:contracts:v1:execution-status"
    },
    "cancel.request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "deadline_utc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "execution_id",
        "reason",
        "deadline_utc"
      ]
    },
    "cancel.result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "confirmed": {
          "type": "boolean"
        },
        "cleanup": {
          "$ref": "urn:forgecode:contracts:v1:cleanup-report"
        }
      },
      "required": [
        "execution_id",
        "confirmed",
        "cleanup"
      ]
    },
    "close.request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sandbox_session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^sandbox-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "sandbox_session_id"
      ]
    },
    "close.result": {
      "$ref": "urn:forgecode:contracts:v1:cleanup-report"
    }
  }
}
