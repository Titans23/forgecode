{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgecode:contracts:v1:command-spec",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "argv"
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "maxItems": 256,
          "minItems": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?:[A-Za-z]:[/\\\\]|/)(?![/\\\\]).*$"
        },
        "environment": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384
          }
        },
        "deadline_utc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "format": "date-time",
          "pattern": "Z$"
        },
        "output_limit_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "mode",
        "argv",
        "cwd",
        "environment",
        "deadline_utc",
        "output_limit_bytes"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "shell_script"
        },
        "shell": {
          "enum": [
            "pwsh",
            "bash",
            "sh"
          ]
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?:[A-Za-z]:[/\\\\]|/)(?![/\\\\]).*$"
        },
        "environment": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 16384
          }
        },
        "deadline_utc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "format": "date-time",
          "pattern": "Z$"
        },
        "output_limit_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "mode",
        "shell",
        "script",
        "cwd",
        "environment",
        "deadline_utc",
        "output_limit_bytes"
      ]
    }
  ]
}
