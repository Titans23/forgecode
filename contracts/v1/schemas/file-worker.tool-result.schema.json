{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgecode:contracts:v1:file-worker.tool-result",
  "type": "object", "additionalProperties": false,
  "properties": {
    "success": {"type": "boolean"}, "summary": {"type": "string"}, "content": {"type": "string"},
    "metadata": {"type": "object"},
    "error": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "details": {"type": "object"}},
      "required": ["code", "message", "details"]}]}
  }, "required": ["success", "summary", "content", "metadata", "error"],
  "oneOf": [
    {"properties": {"success": {"const": true}, "error": {"type": "null"}}},
    {"properties": {"success": {"const": false}, "error": {"type": "object"}}}
  ]
}
