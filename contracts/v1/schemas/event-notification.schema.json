{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgecode:contracts:v1:event-notification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "method": {
      "const": "events.batch"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subscription_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^sub-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "urn:forgecode:contracts:v1:event-envelope"
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "subscription_id",
        "cursor",
        "events"
      ]
    }
  },
  "required": [
    "jsonrpc",
    "method",
    "params"
  ]
}
