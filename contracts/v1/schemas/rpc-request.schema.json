{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgecode:contracts:v1:rpc-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "params": {
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "method",
    "params"
  ]
}
