{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgecode:contracts:v1:artifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^art-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "redaction_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "available": {
      "type": "boolean"
    }
  },
  "required": [
    "artifact_id",
    "size_bytes",
    "sha256",
    "media_type",
    "redaction_version",
    "available"
  ]
}
