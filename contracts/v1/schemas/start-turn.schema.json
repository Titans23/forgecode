{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgecode:contracts:v1:start-turn",
  "title": "session.start_turn params v1",
  "description": "仅 RPC params；受理事务、归属、revision、凭证和幂等规则由 Engine 验证。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "client_action_id": {
      "type": "string",
      "pattern": "^act-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^ses-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expected_workspace_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "input": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "text"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 131072
          }
        },
        "required": [
          "type",
          "text"
        ]
      },
      "minItems": 1,
      "maxItems": 32
    },
    "connection_id": {
      "type": "string",
      "pattern": "^conn-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^policy-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "budget_profile_id": {
      "type": "string",
      "pattern": "^budget-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "client_action_id",
    "session_id",
    "expected_workspace_revision",
    "input",
    "connection_id",
    "policy_id",
    "budget_profile_id"
  ]
}
