#!/bin/sh
set -eu

case "${1:-}" in
  remove)
    source=/usr/lib/forgecode/resources/linux/forgecode-userns
    target=/etc/apparmor.d/forgecode-userns
    # Preserve administrator edits and unrelated/shared profiles.
    if [ -f "$target" ] && [ ! -L "$target" ] && cmp -s "$source" "$target"; then
      if [ -d /sys/kernel/security/apparmor ]; then
        /sbin/apparmor_parser -R "$target"
      fi
      rm -- "$target"
    fi
    ;;
esac
