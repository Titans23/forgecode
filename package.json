{
  "name": "forgecode-workspaces",
  "version": "0.1.2",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "sandbox_bridge"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/install.mjs",
    "lint": "python scripts/quality.py",
    "contracts:check": "node packaging/check-contracts.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:sandbox": "python scripts/build_bridge.py",
    "pretest:unit": "npm run build --workspace @forgecode/contracts && npm run build --workspace @forgecode/sandbox-bridge",
    "test:unit": "node --test tests/implementation/node/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.2.1-alpha.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
