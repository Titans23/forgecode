# ForgeCode model configuration
# Copy this file to .env, then replace the placeholder values.
# Never commit your real .env file.

# Protocol selection: anthropic (default), openai_responses, or deepseek.
# Set this explicitly when switching API protocols. MODEL_ID is still supported.
FORGE_PROVIDER=anthropic
# FORGE_MODEL=your-model-id
# FORGE_API_KEY=your-api-key
# FORGE_BASE_URL=https://your-compatible-endpoint
# FORGE_REASONING_EFFORT=medium
# Native OpenAI Responses: FORGE_PROVIDER=openai_responses and OPENAI_API_KEY.
# Native DeepSeek Chat Completions: FORGE_PROVIDER=deepseek and DEEPSEEK_API_KEY.
# OPENAI_BASE_URL / DEEPSEEK_BASE_URL override each provider's official default.
# FORGE_* overrides take precedence over provider-specific environment variables.

# API Key (required)
# Anthropic keys: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key

# Model ID (required)
MODEL_ID=claude-sonnet-4-6

# Maximum output tokens for one model request (optional, 1024-32768)
MODEL_MAX_TOKENS=8192

# Total model context window (optional, provider/model-specific)
# Check your provider documentation before setting this value.
MODEL_CONTEXT_WINDOW=128000

# Per-request stream inactivity timeout in seconds (optional, default: 120)
MODEL_REQUEST_TIMEOUT_SECONDS=120

# Base URL (optional)
# Remove this line to use the official Anthropic API.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Feishu official bot configuration
# Keep the real values in .env; do not commit them.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=your-feishu-app-secret
FEISHU_CHANNEL_NAME=feishu-main
FEISHU_ENABLED=true
FEISHU_TRANSPORT=websocket
FEISHU_TENANT_ID=company-main
# Comma-separated Feishu open_id values. At least one allowlist is required.
FEISHU_ALLOWED_USERS=
# Comma-separated Feishu chat_id values; leave empty for direct-message-only testing.
FEISHU_ALLOWED_CHATS=
FEISHU_REQUIRE_MENTION=true
FEISHU_APPROVAL_TIMEOUT_SECONDS=600

# =============================================================================
# Anthropic-compatible provider examples
# Verify current model availability, pricing, and regional access in the
# provider's official documentation before use.
# =============================================================================

# Anthropic
# MODEL_ID=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# MiniMax international
# MODEL_ID=MiniMax-M2.7
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic

# MiniMax China mainland
# MODEL_ID=MiniMax-M2.7
# ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# GLM (Zhipu)
# MODEL_ID=glm-5.2
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# DeepSeek
# MODEL_ID=deepseek-v4-flash
# MODEL_ID=deepseek-v4-pro
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Kimi Code membership uses a separate key and server-side model routing.
# Check Kimi Code documentation before use.
# ANTHROPIC_BASE_URL=https://api.kimi.com/coding/
